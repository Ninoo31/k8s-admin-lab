# ─────────────────────────────────────────────────────────────
# Paramètres du cluster — lus par tous les scripts du lab
# ─────────────────────────────────────────────────────────────

# Version mineure de Kubernetes. Le patch exact (ex: 1.35.4) est
# résolu au moment du téléchargement via dl.k8s.io/release/stable-X.Y.txt
# → aligne-la sur la version de ton examen CKA (vérifie sur la page LF).
K8S_MINOR="1.35"

# Plage d'IP virtuelles des Services (ClusterIP)
SERVICE_CIDR="10.96.0.0/12"
# 1re IP de SERVICE_CIDR = le Service "kubernetes" (default ns).
# Les Pods joignent l'API par elle → elle DOIT être dans les SAN du cert API.
API_SERVICE_IP="10.96.0.1"
# IP fixe du Service DNS (CoreDNS), donnée à chaque kubelet
CLUSTER_DNS="10.96.0.10"

# Plage des Pods, découpée en un /24 par worker (voir machines.txt)
CLUSTER_CIDR="10.200.0.0/16"

CLUSTER_NAME="kubernetes-the-hard-way"

# Où la PKI est générée sur le control plane
PKI_DIR="/root/k8s-pki"
